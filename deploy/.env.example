# Copie para deploy/.env e preencha com os dados de FTP da hospedagem.
FTP_HOST=ftp.seudominio.com.br
FTP_PORT=21
FTP_USER=
FTP_PASS=
FTP_SSL=false
FTP_PASSIVE=true
# Pasta remota que corresponde à raiz deste repositório (ex.: /public_html)
FTP_REMOTE_ROOT=/web
# Pasta remota do sistema compilado (publicar-sistema.bat)
FTP_REMOTE_ROOT_SISTEMA=/web/sistema
