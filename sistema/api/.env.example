# Copie para .env e preencha. NUNCA versione o .env.
APP_ENV=local            # local | homolog | production
APP_DEBUG=true           # false em produção
APP_URL=http://localhost:5173

# Banco MySQL (use a base de HOMOLOGAÇÃO localmente)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=studyinghomo
DB_USER=
DB_PASS=
DB_SSL_CA=               # caminho do certificado CA, se o servidor exigir SSL

# Autenticação — gere com: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_TTL=900              # access token: 15 min
REFRESH_TTL=1209600      # refresh token: 14 dias
COOKIE_SECURE=false      # true em produção (HTTPS)

# Enquanto o sistema .NET antigo rodar em paralelo, mantenha false
# (a senha em texto continua na coluna SENHA). Na virada, troque para true.
LEGACY_CLEAR_PLAINTEXT=false

# Origens permitidas no CORS (separadas por vírgula). Suporta *.dominio
CORS_ORIGINS=http://localhost:5173,https://*.studyingonline.com.br

# Domínio base para identificar a instituição pelo subdomínio
BASE_DOMAIN=studyingonline.com.br

# E-mail (Brevo)
BREVO_API_KEY=
MAIL_FROM=nao-responda@studyingonline.com.br
MAIL_FROM_NAME="Studying Online"

# Só em desenvolvimento com "php -S": faz a API responder em /api como na produção
# API_BASE_PATH=/api

# Pagamentos (Fase 5). Credenciais de cada instituição ficam em CONTA_BANCARIA (tela "Contas de recebimento").
# Proxies da Adaline usados pelo legado (BoletoCloud e Vindi/PagSeguro):
BOLETOCLOUD_PROXY_URL=
BOLETOCLOUD_API_TOKEN=
GATEWAY_PROXY_URL=
MERCADOPAGO_API_URL=https://api.mercadopago.com
# URL pública da API (para o webhook do MercadoPago). Padrão: APP_URL + /api
PUBLIC_API_URL=

# Rotina diária (agendador de tarefas da Locaweb chama POST /api/rotinas/diaria com o header X-Rotinas-Token)
# Gere com: php -r "echo bin2hex(random_bytes(24));"
ROTINAS_TOKEN=
