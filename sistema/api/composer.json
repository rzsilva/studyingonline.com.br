{
    "name": "studyingonline/api",
    "description": "API REST do Studying Online (PHP 8.2)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "firebase/php-jwt": "^7.2",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php bin/migrate.php",
        "serve": "php -S localhost:8080 -t public"
    },
    "config": {
        "platform": { "php": "8.1.0" },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
