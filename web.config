<?xml version="1.0" encoding="UTF-8"?>
<!--
  Raiz do site principal (/web) na Locaweb Windows/IIS.
  O subdomínio do sistema (novo./sistema.) é servido pela Locaweb reescrevendo para /sistema/...,
  e nesse caminho as regras de /web/sistema/web.config não rodam. Por isso a SPA e a API
  do sistema são roteadas aqui, só para os hosts do sistema (a landing não é afetada).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Sistema API" stopProcessing="true">
          <match url="^(?:sistema/)?api/(?!index\.php)(.*)$" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^(novo|sistema)\.studyingonline\.com\.br$" />
          </conditions>
          <action type="Rewrite" url="sistema/api/index.php" appendQueryString="true" />
        </rule>
        <!-- rotas do React (sem extensão de arquivo) -> index.html do sistema -->
        <rule name="Sistema SPA" stopProcessing="true">
          <match url="^(?:sistema/)?([^.]*)$" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^(novo|sistema)\.studyingonline\.com\.br$" />
          </conditions>
          <action type="Rewrite" url="sistema/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
